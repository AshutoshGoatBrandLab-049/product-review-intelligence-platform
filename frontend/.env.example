# Phase 7 Step 1 — frontend environment configuration.
#
# SECURITY: Vite only ever bundles VITE_-prefixed variables into client
# code — this is a platform guarantee. Never put JWT_SECRET, database
# credentials, or AI provider keys in this file or any .env* file the
# frontend loads; those live in backend/.env only, and this app never
# reads them.

# The Phase 6 API's base URL.
VITE_API_BASE_URL=http://localhost:4000

# Development-only bearer token, issued by the backend's CLI tool (there is
# no login endpoint — Phase 6 deliberately has none):
#   cd backend && AI_PROVIDER=mock npx tsx scripts/issueDevToken.ts viewer
# Never a production authentication mechanism.
VITE_DEV_TOKEN=
