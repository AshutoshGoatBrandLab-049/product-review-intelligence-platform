# ── Local application store — writable, dev/test only ────────────────────────
# The ONLY database this project ever creates tables in, runs migrations
# against, or writes test/application data to.
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gbl_data_lake
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=product_review_intelligence

# ── Production source — READ ONLY. review_intel_ro role, SELECT-only. ────────
# Allowed tables: DataWarehouse.flipkart_reviews, DataWarehouse.myntra_reviews
# and nothing else. Never used for migrations. Never used with Sequelize models.
DB_PROD_HOST=
DB_PROD_PORT=5432
DB_PROD_NAME=gbl_data_lake
DB_PROD_SCHEMA=DataWarehouse
DB_PROD_USER=review_intel_ro
DB_PROD_PASSWORD=

NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ── Ingestion tuning ───────────────────────────────────────────────────────────
INGEST_BATCH_SIZE=5000
RECONCILE_LOOKBACK_DAYS=60
RECONCILE_SAFETY_BUFFER_DAYS=10

# ── AI provider (Phase 4) ──────────────────────────────────────────────────────
# Defaults to "mock" — this project must never silently start making paid API
# calls just because it booted. Set AI_PROVIDER=anthropic or AI_PROVIDER=gemini
# and provide the matching key only when you intend to actually call that
# provider. Only the exact string set here activates a real provider.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_BATCH_SIZE=20
AI_MAX_RETRIES=3
AI_RETRY_MIN_TIMEOUT_MS=1000

# ── Early-warning thresholds (Phase 5) ─────────────────────────────────────────
# Defaults below are tuned against the real, restored local dataset (Step 4,
# scripts/phase5EarlyWarningTuningStep4.ts) — see src/config/index.ts for the
# exact observed evidence behind each value. Set these only if you intend to
# deliberately override the data-derived defaults.
WARNING_RATING_DECLINE_PCT=-15
WARNING_NEGATIVE_INCREASE_PCT=100
WARNING_VOLUME_SPIKE_MULTIPLIER=3
WARNING_COMPLAINT_SPIKE_PCT=200

# ── API auth / rate limiting (Phase 6) ─────────────────────────────────────────
# JWT_SECRET has NO safe default — the API server (src/server.ts) refuses to
# start with an empty secret (assertJwtSecretConfigured). Every other process
# in this repo (ingestion, analytics, AI scripts) never touches this value.
JWT_SECRET=development-jwt-secret-for-local-testing-only
JWT_EXPIRES_IN=12h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# NOTE: there is deliberately no environment variable anywhere in this project
# that can make application-store migrations run against a non-local host.
# DB_HOST must resolve to localhost / 127.0.0.1 / ::1 or `npm run migrate`
# refuses to run, unconditionally. See src/config/assertLocalMigrationTarget.ts.
